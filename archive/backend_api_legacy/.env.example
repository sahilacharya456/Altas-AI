NODE_ENV=development
PORT=3001
API_VERSION=v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/atlas-ai
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
REDIS_URL=

# Legacy API is not the production mobile backend.
# Paid AI keys are server-side only and must never be copied into apps/mobile.
