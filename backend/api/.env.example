# AltasAI Backend - Environment Variables
# Copy this file to .env and fill placeholders locally.
# Never commit .env. Never expose server-side keys through EXPO_PUBLIC_* vars.

# Server
PORT=3001
NODE_ENV=development

# CORS
# Comma-separated development origins. Add production origins only when deployed.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local emulator development only. Leave unset when using a real Firebase project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Use one Firebase Admin credential path:
# 1. Local ADC: run `gcloud auth application-default login` and leave JSON blank.
# 2. Service account JSON: paste a single-line JSON value into FIREBASE_SERVICE_ACCOUNT_JSON.
# 3. File path: set GOOGLE_APPLICATION_CREDENTIALS to a local JSON file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# AI provider keys stay server-side only.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Quotas
AI_DAILY_QUOTA=60

# ML service
# The API gracefully falls back when this service is unavailable.
ML_SERVICE_BASE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_MS=3500

# App Check
# Keep false until Firebase App Check is configured and mobile tokens are verified.
REQUIRE_APP_CHECK=false

# Admin metrics
# Use a long random value in production. This placeholder is not a secret.
ADMIN_METRICS_TOKEN=replace-with-32-char-random-string-in-production

# Stripe subscriptions
# These are optional for local development. Leave blank to keep Checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=
