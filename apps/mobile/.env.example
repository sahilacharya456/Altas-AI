EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Spark-compatible backend API. Local default uses backend/api on port 3001.
EXPO_PUBLIC_ALTASAI_API_BASE_URL=http://localhost:3001

# Do not add Gemini, OpenAI, or other paid AI provider keys here.
# Mobile clients must call the backend API; AI keys stay server-side only.

# Crash reporting (optional but recommended for production). See docs/CRASH_REPORTING_SETUP.md
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
