# AltasAI Backend API — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env (it's in .gitignore)

PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
FIREBASE_PROJECT_ID=your_project_id
GEMINI_MODEL=gemini-2.5-flash

# Get from Firebase Console > Project Settings > Service Accounts
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_real_key

# Get from https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret

# Get from https://dashboard.stripe.com/products
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_with_real_pro_monthly_id
STRIPE_TEAM_MONTHLY_PRICE_ID=price_replace_with_real_team_monthly_id