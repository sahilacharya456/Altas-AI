PORT=3001
NODE_ENV=development

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Firebase project used by the Expo app.
FIREBASE_PROJECT_ID=altasai

# Required for verifying Firebase Auth ID tokens and privileged Firestore writes.
# In Render, store the full JSON as one env var.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"altasai","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@altasai.iam.gserviceaccount.com","client_id":"..."}

# Server-side only. Never expose this in Expo EXPO_PUBLIC_* variables.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Max AI calls per user per day across all buckets.
AI_DAILY_QUOTA=60

# Internal ML service for trainable models. Gracefully falls back when unavailable.
ML_SERVICE_BASE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_MS=3500

# Set to true in production once Firebase App Check is configured in the mobile app.
REQUIRE_APP_CHECK=false

# Required in production to protect /metrics and /admin/stats endpoints.
# Must be at least 16 characters. Leave blank in development to allow unauthenticated local access.
ADMIN_METRICS_TOKEN=
