{
  "name": "@altasai/backend",
  "version": "1.0.0",
  "private": true,
  "description": "AltasAI Spark-compatible backend API for server-side AI calls",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:rules": "firebase emulators:exec --only firestore \"jest src/__tests__/firestore.rules.test.ts --runInBand\"",
    "evaluate:altasai": "tsx src/altasai/evaluation/evaluationRunner.ts",
    "train:intent": "tsx src/altasai/ml/trainIntentModel.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.1.0",
    "stripe": "^22.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "firebase-tools": "^15.19.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
