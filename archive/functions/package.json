{
    "name": "atlas-ai-functions",
    "version": "1.0.0",
    "description": "Cloud Functions for ATLAS AI system",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns=firestore.test.ts",
        "test:rules": "firebase emulators:exec --only firestore \"jest --forceExit --detectOpenHandles src/firestore.test.ts\""
    },
    "engines": {
        "node": "20"
    },
    "dependencies": {
        "@google/genai": "^2.6.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^4.5.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.0.0",
        "firebase-tools": "^15.17.0",
        "jest": "^30.4.1",
        "ts-jest": "^29.4.9",
        "typescript": "^5.0.0"
    },
    "private": true
}
